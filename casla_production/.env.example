APP_NAME=Casla Group
# Development only. Release builds default to false.
ENABLE_DEMO_DATA=true

# Shared root every OData V4 service is exposed under. For development this can
# be the SAP tenant directly. For production it must be the trusted gateway
# origin, which proxies the same service suffixes to SAP.
SAP_BASE_URL=https://your-tenant-api.s4hana.cloud.sap/sap/opu/odata4/sap/

# ZAPI_PP_SHIFT shares SAP_BASE_URL. Its published binding suffix is kept in
# AppConfig as zapi_pp_shift/srvd_a2x/sap/zui_pp_shift_api/0001/.

# Transport authentication mode:
# - basic: direct SAP access for development/staging only.
# - gateway: production mode. Mobile sends no shared Basic Authorization header;
#   the trusted gateway owns the upstream SAP service credential.
SAP_TRANSPORT_AUTH_MODE=basic

# Development/staging direct-SAP bridge only. NEVER define these in a production
# APK/IPA. Production release guards require SAP_TRANSPORT_AUTH_MODE=gateway and
# reject any embedded SAP_BASIC_AUTH_USER/SAP_BASIC_AUTH_PASSWORD values.
SAP_BASIC_AUTH_USER=replace-me
SAP_BASIC_AUTH_PASSWORD=replace-me
