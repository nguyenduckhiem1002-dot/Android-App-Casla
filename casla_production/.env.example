APP_NAME=Casla Group
# Development only. Release builds default to false.
ENABLE_DEMO_DATA=true

# Legacy — ZUI_USER_QR_API does not exist in the real backend and nothing
# reads this anymore. Left only for backward compatibility with old configs.
SAP_BASE_URL=https://your-host/sap/opu/odata/sap/ZUI_USER_QR_API/

# Real mobile services (RAP OData V4). Copy the exact service root from the
# tenant's Communication Arrangement / Service Binding — the path below is the
# standard ABAP Cloud shape, not a guaranteed value:
#   /sap/opu/odata4/sap/<binding-name>/srvd_a2x/sap/<service-definition>/0001/
SAP_AUTH_SERVICE_URL=https://your-host/sap/opu/odata4/sap/zui_mob_auth_o4/srvd_a2x/sap/zui_mob_auth/0001/
SAP_PP_OPALLOC_SERVICE_URL=https://your-host/sap/opu/odata4/sap/zui_pp_opalloc_o4/srvd_a2x/sap/zui_pp_opalloc/0001/

# Development bridge only. Do not embed a shared SAP service account in a
# production APK/IPA; production must use a gateway-issued user token.
SAP_BASIC_AUTH_USER=replace-me
SAP_BASIC_AUTH_PASSWORD=replace-me
