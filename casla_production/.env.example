APP_NAME=Casla Group
# Development only. Release builds default to false.
ENABLE_DEMO_DATA=true

# Shared root every OData V4 service on the tenant is published under.
# AppConfig appends the fixed, per-service suffix (zapi_mob_auth/... and
# zapi_pp_opalloc/...) itself — see lib/core/config/app_config.dart. Only the
# host segment below needs to change per tenant/environment.
SAP_BASE_URL=https://your-tenant-api.s4hana.cloud.sap/sap/opu/odata4/sap/

# Development bridge only. Do not embed a shared SAP service account in a
# production APK/IPA; production must use a gateway-issued user token.
SAP_BASIC_AUTH_USER=replace-me
SAP_BASIC_AUTH_PASSWORD=replace-me
