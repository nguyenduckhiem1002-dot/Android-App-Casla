@EndUserText.label : 'Phân bổ sản lượng công đoạn'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table ztb_pp_op_alloc {
  key client            : abap.clnt not null;
  key operation_uuid    : sysuuid_x16 not null;
  production_order      : abap.char(12) not null;
  operation_no          : abap.char(4) not null;
  plant                 : abap.char(4) not null;
  work_center           : abap.char(8) not null;
  @Semantics.quantity.unitOfMeasure : 'ztb_pp_op_alloc.uom'
  operation_qty         : abap.quan(15,3) not null;
  uom                   : abap.unit(3) not null;
  operation_status      : abap.char(12) not null;
  created_by            : abp_creation_user;
  created_at            : abp_creation_tstmpl;
  last_changed_by       : abp_lastchange_user;
  local_last_changed_at : abp_locinst_lastchange_tstmpl;
}
