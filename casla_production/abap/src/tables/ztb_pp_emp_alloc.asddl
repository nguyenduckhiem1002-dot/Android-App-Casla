@EndUserText.label : 'Số dư phân bổ nhân công'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table ztb_pp_emp_alloc {
  key client            : abap.clnt not null;
  key emp_alloc_uuid    : sysuuid_x16 not null;
  operation_uuid        : sysuuid_x16 not null;
  worker_id             : abap.char(8) not null;
  @Semantics.quantity.unitOfMeasure : 'ztb_pp_emp_alloc.uom'
  initial_assigned_qty  : abap.quan(15,3) not null;
  @Semantics.quantity.unitOfMeasure : 'ztb_pp_emp_alloc.uom'
  transferred_in_qty    : abap.quan(15,3) not null;
  @Semantics.quantity.unitOfMeasure : 'ztb_pp_emp_alloc.uom'
  transferred_out_qty   : abap.quan(15,3) not null;
  @Semantics.quantity.unitOfMeasure : 'ztb_pp_emp_alloc.uom'
  completed_qty         : abap.quan(15,3) not null;
  @Semantics.quantity.unitOfMeasure : 'ztb_pp_emp_alloc.uom'
  remaining_qty         : abap.quan(15,3) not null;
  uom                   : abap.unit(3) not null;
  last_execution_date   : abap.dats;
  last_sync_at          : abap.utclong;
  created_by            : abp_creation_user;
  created_at            : abp_creation_tstmpl;
  last_changed_by       : abp_lastchange_user;
  local_last_changed_at : abp_locinst_lastchange_tstmpl;
}
