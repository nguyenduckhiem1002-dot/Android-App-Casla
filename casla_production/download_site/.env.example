# Chép file này thành .env.local (máy phát hành) và khai báo cùng tên biến trên
# Vercel (Project → Settings → Environment Variables). KHÔNG commit .env.local.

# Token đọc/ghi của Blob store. Vercel tự thêm biến này vào project khi nối
# store; máy phát hành lấy bằng `vercel env pull .env.local` hoặc chép từ
# Storage → store → tab ".env.local".
BLOB_READ_WRITE_TOKEN=

# Kiểu store đã tạo trên Vercel: public (mặc định) hoặc private.
# Hai nơi (Vercel và .env.local) phải cùng một giá trị.
BLOB_ACCESS=public

# Chỉ dùng ở máy phát hành: địa chỉ trang sau khi deploy, để script in link.
SITE_URL=
